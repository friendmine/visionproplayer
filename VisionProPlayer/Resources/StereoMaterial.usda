#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Root" {
    def Material "EyeCheckMaterial" {
        token outputs:mtlx:surface.connect = </Root/EyeCheckMaterial/Surface.outputs:out>
        def Shader "EyeSwitch" {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_color3"
            color3f inputs:mono = (0, 1, 0)
            color3f inputs:left = (1, 0, 0)
            color3f inputs:right = (0, 0, 1)
            color3f outputs:out
        }
        def Shader "Surface" {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = false
            color3f inputs:color.connect = </Root/EyeCheckMaterial/EyeSwitch.outputs:out>
            float inputs:opacity = 1
            token outputs:out
        }
    }
    def Material "StereoMaterial" {
        asset inputs:LeftTexture = @Black.png@
        asset inputs:RightTexture = @Black.png@
        token outputs:mtlx:surface.connect = </Root/StereoMaterial/Surface.outputs:out>
        def Shader "Left" {
            uniform token info:id = "ND_image_color3"
            asset inputs:file.connect = </Root/StereoMaterial.inputs:LeftTexture>
            color3f inputs:default = (0, 0, 0)
            color3f outputs:out
        }
        def Shader "Right" {
            uniform token info:id = "ND_image_color3"
            asset inputs:file.connect = </Root/StereoMaterial.inputs:RightTexture>
            color3f inputs:default = (0, 0, 0)
            color3f outputs:out
        }
        def Shader "EyeSwitch" {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_color3"
            color3f inputs:mono.connect = </Root/StereoMaterial/Left.outputs:out>
            color3f inputs:left.connect = </Root/StereoMaterial/Left.outputs:out>
            color3f inputs:right.connect = </Root/StereoMaterial/Right.outputs:out>
            color3f outputs:out
        }
        def Shader "Surface" {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = false
            color3f inputs:color.connect = </Root/StereoMaterial/EyeSwitch.outputs:out>
            float inputs:opacity = 1
            token outputs:out
        }
    }
}
